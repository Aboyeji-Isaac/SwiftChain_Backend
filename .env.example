# ═══════════════════════════════════════════════════════════════════════════════
# SwiftChain Backend — Environment Reference
# ═══════════════════════════════════════════════════════════════════════════════
#
# HOW TO USE
#   cp .env.example .env      # then edit the values you need
#
# This file mirrors the Zod schema in `src/config/env.ts`. That schema is parsed
# once at boot (`envSchema.parse(process.env)`); on failure the process prints
#   ❌ Invalid environment variables:
#     - <VAR>: <message>
# and exits with code 1. Values are therefore validated on format, not just
# presence — e.g. `PORT=abc`, `BCRYPT_ROUNDS=99` or `LOG_LEVEL=loud` will abort
# startup even though a default exists.
#
# Every value below is declared in the schema, so the default shown in the
# comment is the real one applied when the variable is absent or blank.
# Assigning an empty value (`PORT=`) is treated as "unset" and falls back to the
# default, except for the handful of fields that must not be blank — those are
# called out explicitly.
#
# LEGEND
#   [default: X]  → declared with a default; safe to omit.
#   [optional]    → `z.string().optional()`; no schema default. Omit rather
#                   than blank it out, since some consumers expect `undefined`.
#   [REQUIRED …]  → must be set for the described feature to work.
#
# ─── Server ───────────────────────────────────────────────────────────────────

# Runtime mode. Controls error verbosity, log format, transports, and whether
# background jobs boot. Allowed: development | test | production.
# [default: development]
NODE_ENV=development

# HTTP port the Express server + Socket.io listen on. Range 1–65535.
# [default: 3000]
PORT=3000

# Public base URL this API is reachable at. Used to build local-storage file
# URLs (`${APP_BASE_URL}/uploads/<key>`) and in the Swagger server definition.
# [default: http://localhost:3000]
APP_BASE_URL=http://localhost:3000

# Mongoose connection string. Include credentials for Atlas:
#   mongodb+srv://<user>:<pass>@<cluster>/swiftchain?retryWrites=true&w=majority
# [default: mongodb://localhost:27017/swiftchain]
MONGODB_URI=mongodb://localhost:27017/swiftchain

# ─── Auth / security ──────────────────────────────────────────────────────────

# HMAC secret used to sign and verify access tokens. Minimum 16 characters.
# MUST be overridden in production — the default is a well-known placeholder.
# [default: change_me_in_prod_change_me]
JWT_SECRET=local_dev_only_jwt_secret_change_me_32chars

# Token lifetime in `ms`-library format (e.g. 15m, 24h, 7d). [default: 7d]
JWT_EXPIRES_IN=7d

# bcrypt cost factor for password hashing. Range 8–31; higher is slower and
# stronger. [default: 10]
BCRYPT_ROUNDS=10

# Allowed CORS origins, comma-separated. A literal `*` permits any origin.
# Parsed as a list by `getAllowedOrigins` in `src/config/security.ts` and used
# for the Express, Socket.io and Swagger CORS policies.
# [default: *]  → set an explicit list outside development.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Sliding-window size in milliseconds for the global rate limiter. Minimum 1000.
# [default: 900000] (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per client per window before a 429 is returned. [default: 100]
RATE_LIMIT_MAX_REQUESTS=100

# Outbound webhook that receives dispute lifecycle notifications. Empty string
# (the default) disables notifications. [default: "" — set to enable]
# NOTE: declared in the schema but not yet read by any service; wire it up in
# `src/services/disputeService.ts` when dispute notifications are implemented.
DISPUTE_NOTIFICATION_WEBHOOK_URL=

# ─── Uploads / storage ────────────────────────────────────────────────────────

# Storage backend for uploaded evidence files and profile pictures.
# Allowed: local | s3. [default: local]
UPLOAD_STORAGE_DRIVER=local

# Directory, relative to the project root, that the `local` driver writes to.
# Served read-only at `/uploads` by `src/app.ts`. [default: uploads]
UPLOAD_LOCAL_DIR=uploads

# Maximum accepted evidence file size in MB. Enforced in
# `src/routes/uploadRoutes.ts` (multer) and `src/services/evidenceService.ts`.
# [default: 10]
UPLOAD_MAX_FILE_SIZE_MB=10

# [optional]  S3 bucket that receives evidence/profile uploads.
# [REQUIRED when UPLOAD_STORAGE_DRIVER=s3] — `src/config/env.ts` aborts startup
# with "AWS_S3_BUCKET is required when UPLOAD_STORAGE_DRIVER=s3".
AWS_S3_BUCKET=

# [optional]  AWS region of the evidence bucket. [REQUIRED when the driver is s3]
AWS_REGION=us-east-1

# [optional]  Static S3 credentials. When both are set they are passed
# explicitly; when both are empty the AWS SDK falls back to the instance/IRSA
# role. Prefer the role in production.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# How long, in seconds, a signed S3 evidence URL stays valid. [default: 3600]
AWS_S3_SIGNED_URL_EXPIRES_SECONDS=3600

# ─── Redis ───────────────────────────────────────────────────────────────────

# ioredis connection URL. Used for ETA result caching, Idempotency-Key records
# and Redlock distributed locking. Startup continues without Redis outside
# production. [default: redis://localhost:6379]
REDIS_URL=redis://localhost:6379

# Lock time-to-live in ms; a lock not released within this window auto-expires.
# Minimum 1000. [default: 10000]
REDIS_LOCK_TTL_MS=10000

# Number of Redlock acquisition attempts before the caller gives up. Minimum 0.
# [default: 3]
REDIS_LOCK_RETRY_COUNT=3

# Delay in ms between Redlock acquisition attempts. Minimum 50. [default: 200]
REDIS_LOCK_RETRY_DELAY_MS=200

# ─── Idempotency ──────────────────────────────────────────────────────────────

# TTL (seconds) for cached Idempotency-Key responses, read in
# `src/services/idempotency.service.ts`. Minimum 60. [default: 86400] (24h)
IDEMPOTENCY_TTL_SECONDS=86400

# ─── Profile pictures ────────────────────────────────────────────────────────

# These four stay unvalidated strings on purpose: they are consumed as
# `parseInt(value ?? fallback)`, and a malformed value degrades to the fallback
# below rather than aborting startup. Omit them entirely to get the fallbacks.

# Maximum profile-picture size in MB before sharp resizing. [falls back to 5]
PROFILE_PICTURE_MAX_SIZE_MB=5

# Target width in pixels of the resized profile picture. [falls back to 500]
PROFILE_PICTURE_WIDTH=500

# Target height in pixels of the resized profile picture. [falls back to 500]
PROFILE_PICTURE_HEIGHT=500

# JPEG encoder quality, 0–100. [falls back to 85]
PROFILE_PICTURE_QUALITY=85

# ─── Soroban RPC retries ─────────────────────────────────────────────────────

# Maximum attempts (including the first) for generic RPC calls — getAccount,
# getLatestLedger, simulateTransaction. Range 1–20. [default: 3]
SOROBAN_RPC_MAX_RETRIES=3

# Base delay in ms for the exponential back-off between RPC retries.
# Minimum 50. [default: 250]
SOROBAN_RPC_RETRY_BASE_MS=250

# Upper bound in ms for any single back-off interval. Minimum 500. [default: 8000]
SOROBAN_RPC_RETRY_MAX_MS=8000

# How many times a transaction failing with `tx_bad_seq` is rebuilt and
# resubmitted; each attempt re-fetches the account sequence number.
# Range 1–10. [default: 3]
STELLAR_BAD_SEQ_MAX_RETRIES=3

# ─── Soroban / Stellar connection ─────────────────────────────────────────────

# Friendly network alias used for log lines, API responses, and passphrase/RPC
# lookup. Allowed: mainnet | testnet | futurenet. [default: testnet]
# An unrecognised value aborts startup during schema validation.
STELLAR_NETWORK=testnet

# Soroban RPC endpoint. Falls back to the per-network default when unset:
#   testnet   → https://soroban-testnet.stellar.org
#   mainnet   → https://soroban-mainnet.stellar.org
#   futurenet → https://rpc-futurenet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase used when signing/verifying transactions. Must match
# STELLAR_NETWORK / SOROBAN_RPC_URL exactly, otherwise tx simulation fails.
# Falls back to the SDK passphrase for the chosen network. [optional]
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# HTTP request timeout in ms for Soroban RPC calls. [default: 10000]
SOROBAN_RPC_TIMEOUT_MS=10000

# Base fee in stroops used when assembling transactions. [default: 100]
# Mirrors `BASE_FEE` from @stellar/stellar-sdk.
STELLAR_BASE_FEE=100

# Validity window in seconds of the unsigned transaction returned to clients.
# [default: 300]
STELLAR_TRANSACTION_TIMEOUT_SECONDS=300

# Deployed escrow contract id (the "C…" address) used by SorobanService when
# invoking `lock_escrow`. Optional at boot — endpoints needing it return 503.
# [optional]
# SOROBAN_ESCROW_CONTRACT_ID=C…

# Escrow contract function name invoked to lock funds. [default: lock_escrow]
SOROBAN_ESCROW_LOCK_FUNCTION=lock_escrow

# ─── Circuit breakers (Soroban RPC) ──────────────────────────────────────────

# Read by `src/blockchain/soroban.service.ts` and
# `src/services/transactionService.ts` for the `soroban-rpc` and
# `soroban-rpc-tx` breakers, then mapped onto opossum's own option names in
# `src/utils/circuitBreaker.ts` (rollingWindowMs → rollingCountTimeout,
# resetTimeoutMs → resetTimeout, timeoutMs → timeout).

# Percentage of failures within the rolling window that opens the circuit
# (CLOSED → OPEN). Range 1–100. [default: 50]
CB_SOROBAN_ERROR_THRESHOLD_PERCENTAGE=50

# Rolling statistics window in ms. Minimum 1000. [default: 30000]
CB_SOROBAN_ROLLING_WINDOW_MS=30000

# Time in ms the circuit stays OPEN before a single HALF-OPEN probe.
# Minimum 1000. [default: 60000]
CB_SOROBAN_RESET_TIMEOUT_MS=60000

# Minimum calls within the rolling window before the breaker may open; prevents
# spurious trips on a cold start. [default: 5]
CB_SOROBAN_VOLUME_THRESHOLD=5

# Per-call timeout in ms; unresolved calls are aborted and counted as failures.
# [default: 10000]
CB_SOROBAN_TIMEOUT_MS=10000

# ─── ETA cache / routing ──────────────────────────────────────────────────────

# TTL in seconds for cached ETA results in `src/services/etaCacheService.ts`.
# [default: 600] (10 minutes)
ETA_CACHE_TTL_SECONDS=600

# Geohash precision (1–12) used to build ETA cache keys. [default: 7] (~150 m
# buckets)
ETA_GEOHASH_PRECISION=7

# Google Maps Directions API key used by `src/services/routingService.ts`.
# When empty, travel duration falls back to the built-in Haversine estimate.
# [optional]
GOOGLE_MAPS_API_KEY=

# ─── Indexer lag monitor ──────────────────────────────────────────────────────

# Outbound webhook notified when the escrow indexer falls behind. Empty string
# (the default) disables notifications and persists the alert without notifying.
# [default: "" — set to enable]
INDEXER_LAG_WEBHOOK_URL=

# Lag (in ledgers) between the last processed ledger and the network head that
# counts as a breach; an `IndexerAlert` record is persisted on breach.
# [default: 100]
INDEXER_LAG_ALERT_THRESHOLD=100

# How often, in ms, the background indexer-lag check runs.
# `startIndexerLagMonitor()` runs on boot. Minimum 1000. [default: 60000]
INDEXER_LAG_CHECK_INTERVAL_MS=60000

# ─── Escrow indexer ──────────────────────────────────────────────────────────

# Deployed escrow Soroban contract id (the "C…" address) whose events the
# escrow indexer subscribes to. The indexer idles while this is empty.
# [default: ""]
ESCROW_CONTRACT_ID=

# Event topic emitted by the escrow contract when funds are locked.
# [default: escrow_funded]
ESCROW_FUNDED_EVENT_TOPIC=escrow_funded

# node-cron expression driving the escrow monitor job. [default: */5 * * * *]
ESCROW_MONITOR_CRON=*/5 * * * *

# ─── Locations & Socket.io ───────────────────────────────────────────────────

# TTL in seconds for the Redis dedup key guarding duplicate location updates.
# [default: 60]
LOCATION_DEDUP_TTL_SECONDS=60

# Maximum age in ms for an incoming location update; older updates are dropped.
# [default: 300000] (5 minutes)
LOCATION_MAX_AGE_MS=300000

# Tolerance in ms for a client clock running ahead of the server; future
# timestamps beyond this are dropped. [default: 30000] (30 seconds)
LOCATION_MAX_FUTURE_MS=30000

# Maximum number of records returned in one location-sync page. [default: 500]
SYNC_BATCH_SIZE_LIMIT=500

# Socket.io ping timeout in ms before a client is considered unresponsive.
# [default: 20000]
SOCKET_PING_TIMEOUT_MS=20000

# Socket.io ping interval in ms. [default: 25000]
SOCKET_PING_INTERVAL_MS=25000

# Consecutive missed pongs tolerated before the server disconnects a client.
# [default: 2]
SOCKET_MAX_MISSED_PONGS=2

# How long, in ms, a client has to ACK a queued socket message before it is
# dropped. [default: 15000]
SOCKET_MESSAGE_ACK_TIMEOUT_MS=15000

# ─── Shutdown ────────────────────────────────────────────────────────────────

# How long, in ms, to wait for in-flight HTTP/Socket/DB work during SIGTERM /
# SIGINT before forcing `process.exit`. [default: 30000] (30 seconds)
SHUTDOWN_TIMEOUT_MS=30000

# ─── Logging ──────────────────────────────────────────────────────────────────

# Winston log level. Allowed: error | warn | info | http | verbose | debug |
# silly. [default: info]
LOG_LEVEL=info

# ─── Notes on variables that are NOT part of the app schema ──────────────────

# JEST_WORKER_ID is read by Jest itself to detect the test runner, and is
# checked directly in `src/app.ts` and `src/middlewares/rateLimiter.ts` to
# disable background work during tests. Never set it in `.env`.

# JWT_SECRET is declared in the schema and validated at boot, but the request
# path (`src/middleware/authenticate.ts`, `src/services/authService.ts`,
# `src/middleware/auth.ts`) additionally re-reads `process.env.JWT_SECRET` at
# call time so a secret can be swapped without re-importing the config module.

# There is currently no Firebase Cloud Messaging integration — `firebase-admin`
# is not a dependency and no service touches FCM. When push notifications land,
# add the FCM variables here and to `src/config/env.ts` in the same PR so this
# file stays a faithful mirror of the schema.
