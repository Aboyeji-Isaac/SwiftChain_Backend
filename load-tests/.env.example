# ─── Target ─────────────────────────────────────────────────────────────────
# Base URL of the running SwiftChain backend (HTTP + Socket.IO share this host).
LOAD_TEST_BASE_URL=http://localhost:3000
LOAD_TEST_API_VERSION=v1

# MongoDB instance the target backend is connected to. The seed script writes
# real documents here via the app's own Mongoose models — load test traffic
# reads/writes this data through the real HTTP and Socket.IO API, never mocks.
LOAD_TEST_MONGODB_URI=mongodb://localhost:27017/swiftchain

# ─── Seed fixtures ──────────────────────────────────────────────────────────
# Number of driver + customer accounts and deliveries created by
# `npm run seed` before a load test run.
LOAD_TEST_DRIVER_COUNT=25
LOAD_TEST_CUSTOMER_COUNT=25
LOAD_TEST_DELIVERY_COUNT=50

# Shared password for every seeded load-test account (never used outside
# ephemeral/local load-test environments).
LOAD_TEST_USER_PASSWORD=LoadTest#12345

# ─── k6 (HTTP API scenarios) ────────────────────────────────────────────────
K6_VUS=20
K6_DURATION=1m

# ─── Socket.IO load harness ─────────────────────────────────────────────────
SOCKET_LOAD_CONNECTIONS=100
SOCKET_LOAD_DURATION_SEC=60
SOCKET_LOAD_EMIT_INTERVAL_MS=2000
SOCKET_LOAD_RAMP_UP_MS=5000

# ─── k6 Socket.IO load test scenario (socket-load.js) ──────────────────────
# Interval between location_update events per VU (milliseconds).
# Default 3500ms simulates realistic driver app behavior (every 3-5 seconds).
# For the full 10,000 concurrent test, increase fixture counts:
#   LOAD_TEST_DRIVER_COUNT=10000
#   LOAD_TEST_DELIVERY_COUNT=5000
